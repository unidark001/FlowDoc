OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
PORT=8080
MOCK_AI=false

# Optional Supabase Auth/Postgres account mode. Leave blank for anonymous demo mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
FREE_CHECKS=3

# Optional Stripe subscriptions. Keep secret keys server-side only.
APP_URL=http://localhost:8080
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_FAMILY_PRICE_MONTHLY=
STRIPE_FAMILY_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=
